# ==============================================================================
# DROP Website - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# IMPORTANT: NEVER commit your actual `.env.local` or API keys to source control.
# ==============================================================================

# Transactional Email Provider (Resend)
# Obtain your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuv

# Verified sender address configured in Resend.
# For testing with Resend's free tier, you can use: onboarding@resend.dev
# In production, use your verified custom domain address (e.g., hello@dropcraft.org or contact@yourdomain.com)
CONTACT_FROM_EMAIL=DROP Website <onboarding@resend.dev>

# Destination email where contact form submissions will be received.
# In Resend's free tier test mode, this must be the email address you registered your Resend account with.
CONTACT_TO_EMAIL=your-team@example.com

# Optional: Next.js public URL (defaults to window.location.origin in browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
